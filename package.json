{
  "name": "typescript-eslint-symlinks-repro",
  "version": "0.0.0",
  "description": "Repro: symlinked directories cause parserOptions.project errors in typescript-eslint",
  "scripts": {
    "lint:project": "eslint --config eslint.config.project.js \"libs/symlinked-lib/**/*.ts\"",
    "lint:project-debug": "DEBUG=typescript-eslint:* eslint --config eslint.config.project.js \"libs/symlinked-lib/**/*.ts\"",
    "lint:project-symlink-path": "eslint --config eslint.config.project.js \"apps/legacy-app/libs/symlinked-lib/**/*.ts\"",
    "lint:project-true": "eslint --config eslint.config.project-true.js \"libs/symlinked-lib/**/*.ts\"",
    "lint:project-service": "eslint --config eslint.config.project-service.js \"libs/symlinked-lib/**/*.ts\""
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "devDependencies": {
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
